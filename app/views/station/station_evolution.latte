{extends '../layout.latte'}

{block headscript}
	<link rel="stylesheet" href="/public/css/c3.css" nonce="{$nonce}">
	<script src="/public/js/c3.js" nonce="{$nonce}"></script>
	<script src="/public/js/d3@5.js" nonce="{$nonce}"></script>
	<script src="/public/js/main.js" nonce="{$nonce}"></script>
	{if ($pwa['enable'])}
        	<link rel="apple-touch-icon" href="/public/img/apple-touch-icon.png">
        	<link rel="manifest" href="{route('stationpwa', ['station_id' => $station->station_id])}">
    {/if}
{/block}

{block content}

<h1>{$station->description}</h1>
{if ($station->currentDataPoint)}
	<small>Mise à jour le {$station->currentDataPoint->dateutc|date:'d/m/Y à H\hi'} <button id="refresh" class="button" style="font-size: .75em;" disabled>Actualiser</button></small>
	<script nonce="{$nonce}">
	
	</script>
	<div class="tabs one">
		<input id='tab-day' type='radio' name='tabgroupB' checked />
		<label class="pseudo button toggle" for="tab-day">Jour</label>
		<input id='tab-week' type='radio' name='tabgroupB'/>
		<label for='tab-week'><a class="pseudo button toggle" href="{route('station_evolution_week', ['station_id' => $station->station_id])}">Semaine</a></label>
		<input id='tab-month' type='radio' name='tabgroupB'/>
		<label for='tab-month'><a class="pseudo button toggle" href="{route('station_evolution_month', ['station_id' => $station->station_id])}">Mois</a></label>
		<input id='tab-show' type='radio' name='tabgroubB'>
		<label for='tab-show'><a class="pseudo button toggle" href="{route('station_show', ['station_id' => $station->station_id])}">Retour</a></label>
		<br />
		<div class="row">
			<div>
			<a id='tab-day-1' class="button" {if ($history == "1")} disabled {else} href="{route('station_evolution', ['station_id' => $station->station_id, 'history' => "1"])}" {/if}>x1</a>
		<a id='tab-day-2' class="button" {if ($history == "2")} disabled {else} href="{route('station_evolution', ['station_id' => $station->station_id, 'history' => "2"])}" {/if}>x2</a>
		<a id='tab-day-3' class="button" {if ($history == "3")} disabled {else} href="{route('station_evolution', ['station_id' => $station->station_id, 'history' => "3"])}" {/if}>x3</a>
				<h2>Jour</h2>
						<button id='tab-day-1' type='radio' name='tabgroupC' {if ($history == "1")} checked {else} href="{route('station_evolution', ['station_id' => $station->station_id, 'history' => "1"])}" {/if}>x1</button>
		<button id='tab-day-2' type='radio' name='tabgroupC' {if ($history == "2")} checked {else} href="{route('station_evolution', ['station_id' => $station->station_id, 'history' => "2"])}" {/if}>x2</button>
		<button id='tab-day-3' type='radio' name='tabgroupC' {if ($history == "3")} checked {else} href="{route('station_evolution', ['station_id' => $station->station_id, 'history' => "3"])}" {/if}>x3</button>
				<div id="chart_container" style="width: 90%; margin: auto; ">
					<h3>Température extérieure</h3> 
					<div id="daily_temp_chart" data-url="{route('data_daily_temperature', ['station_id' => $station->station_id, 'history' => $history])}"></div>
					<h3>Pluie</h3> 
					<div>
					<article class="card">
						<header style="text-align: center;"><strong>Total</strong></header>
						<span class="label pseudo" style="margin: 0;"><h1 id="daily-rain-total"></h1></span>
					</article>
					</div>
					<div id="daily_rain_chart" data-total-field="daily-rain-total" data-url="{route('data_daily_rain', ['station_id' => $station->station_id, 'history' => $history])}"></div>
					<h3>Pression athmosphérique</h3> 
					<div id="daily_press_chart" data-url="{route('data_daily_pressure', ['station_id' => $station->station_id, 'history' => $history])}"></div>
					<h3>Humidité</h3> 
					<div id="daily_humid_chart" data-url="{route('data_daily_humidity', ['station_id' => $station->station_id, 'history' => $history])}"></div>
					<h3>Température intérieure</h3> 
					<div id="daily_indoortemp_chart" data-url="{route('data_daily_indoortemp', ['station_id' => $station->station_id, 'history' => $history])}"></div>
				</div>
			</div>
		</div>
	</div>
	{else}
	<div>
		<p>Aucune donnée</p>
	</div>
{/if}
{/block}